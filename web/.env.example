# Шаблон окружения. Скопировать в web/.env и подставить свои значения:
#   cp .env.example .env
# Сам .env в .gitignore — ключи в репозиторий не попадают.

# Путь к SQLite. Обязательно ОТНОСИТЕЛЬНЫЙ к web/ — абсолютный file:-URL ломает libsql на Windows.
DATABASE_URL="file:./prisma/dev.db"

# OpenAI — генерация картинок в /studio/generate. Без ключа остальное приложение работает.
OPENAI_API_KEY=

# Steam Web API — кнопка «Из Steam» на главной (запасной источник матча, когда лежит OpenDota).
# Бесплатный ключ: https://steamcommunity.com/dev/apikey. Без него работает только «Из OpenDota».
STEAM_API_KEY=

# Кто может встроить приложение в <iframe> — домены основного сайта через пробел.
# Пусто = только собственный домен ('self'); тогда встраивание извне браузер заблокирует.
# Пример: FRAME_ANCESTORS="'self' https://leagueofspirits.ru https://*.leagueofspirits.ru"
FRAME_ANCESTORS=

# Пароль админки (/admin/login). Закрывает всё, что пишет: правку ростера, студию и запись
# через API; публичная часть остаётся открытой. Пустое значение = админка закрыта наглухо.
# Смена пароля разлогинивает все сессии — ключ подписи куки выводится из него же.
ADMIN_PASSWORD=
