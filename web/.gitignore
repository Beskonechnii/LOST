# Лого команд и фото ростера коммитим: без них релизная сборка выходит пустой,
# а восстановить их из БД нельзя — dev.db в игноре. Генерации OpenAI — черновики
# по мегабайту, в репозитории им делать нечего.
/public/uploads/generated/

# local sqlite db
/dev.db
/dev.db-journal
/prisma/*.db
/prisma/*.db-journal

