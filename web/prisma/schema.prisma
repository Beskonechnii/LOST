// LOST — операционная система: данные / флоу / треккинг.
// Спека: ../../ARCHITECTURE.md. sqlite не поддерживает enum → строковые поля с комментами.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Team {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // ключ импорта и имя файла ассета
  name      String
  tag       String?
  logo      String?
  wordmark  String? // граффити-надпись названия (для анонсов)
  photo     String? // командное фото в рамку
  color     String? // акцент команды, hex
  group     String?
  createdAt DateTime @default(now())

  roster         RosterSpot[]
  matchesA       Match[]       @relation("TeamA")
  matchesB       Match[]       @relation("TeamB")
  matchesWon     Match[]       @relation("Winner")
  matchesRadiant Match[]       @relation("Radiant")
  groupEntries   GroupEntry[]
  seriesHome     GroupSeries[] @relation("SeriesHome")
  seriesAway     GroupSeries[] @relation("SeriesAway")
}

model Player {
  id          Int       @id @default(autoincrement())
  slug        String    @unique // ключ импорта и имя файла фото
  nickname    String
  realName    String?
  accountId   String? // Dota/Steam32 account id (для OpenDota)
  mmr         Int? // из таблицы сезона; у команды не хранится — считается по составу
  photo       String?
  steamUrl    String? // перекрывает ссылку, выведенную из accountId
  dotabuffUrl String?
  stratzUrl   String?
  telegram    String? // хранится без «@» — собачку рисует UI (см. src/lib/profiles.ts)
  birthday    DateTime? // только дата, время не значимо; нужна для возраста в графике и поздравлений
  city        String? // где живёт — город как в CRM, страна опционально следом
  country     String?
  createdAt   DateTime  @default(now())

  spots RosterSpot[]
  stats MatchStat[]
}

/// Место игрока в составе команды. Роль и капитанство живут здесь, а не у игрока: один человек
/// может быть действующим саппортом в одной команде и заменой в другой — это разные места.
/// Инвариант «нельзя быть действующим (поз. 1–5) в двух командах» проверяется в коде
/// (src/lib/roster-spots.ts): sqlite не умеет частичные уникальные индексы.
model RosterSpot {
  id        Int      @id @default(autoincrement())
  role      String? // carry | mid | offlane | soft-support | hard-support | coach | standin (src/lib/roles.ts)
  isCaptain Boolean  @default(false)
  createdAt DateTime @default(now())

  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int

  @@unique([teamId, playerId]) // дважды в одном составе стоять нельзя
}

model Match {
  id              Int       @id @default(autoincrement())
  openDotaMatchId String?   @unique // строкой: id матчей Dota > 32-bit Int
  scheduledAt     DateTime?
  status          String    @default("scheduled") // scheduled | live | finished
  createdAt       DateTime  @default(now())

  teamA         Team  @relation("TeamA", fields: [teamAId], references: [id])
  teamAId       Int
  teamB         Team  @relation("TeamB", fields: [teamBId], references: [id])
  teamBId       Int
  winner        Team? @relation("Winner", fields: [winnerTeamId], references: [id])
  winnerTeamId  Int?
  radiantTeam   Team? @relation("Radiant", fields: [radiantTeamId], references: [id])
  radiantTeamId Int?

  stats         MatchStat[]
  pointsEntries PointsEntry[]
  renders       Render[]
}

/// Строка команды в таблице групповой стадии — как она напечатана в таблице сезона (вкладка «GS»).
/// Групповая стадия отыграна до начала плей-офф и дальше не меняется, поэтому итоги храним как есть,
/// а не пересчитываем: это снимок результата, а не живая таблица лиги (та считается в standings.ts).
model GroupEntry {
  id       Int    @id @default(autoincrement())
  division String // «Division 1»
  group    String // «A» | «B»
  place    Int
  played   Int
  wins     Int
  losses   Int
  points   Int

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId Int

  @@unique([division, group, teamId])
}

/// Личная встреча внутри группы, счёт серии (Bo3). В таблице сезона кросс-таблица не подписана
/// (в шапке логотипы, а не текст), поэтому пары восстановлены по записям В-П и очкам и правятся руками.
/// `guessed` = пару определили расчётом, а не прочитали — такие подсвечиваем в UI.
model GroupSeries {
  id        Int     @id @default(autoincrement())
  division  String
  group     String
  homeScore Int
  awayScore Int
  guessed   Boolean @default(true)

  home   Team @relation("SeriesHome", fields: [homeId], references: [id], onDelete: Cascade)
  homeId Int
  away   Team @relation("SeriesAway", fields: [awayId], references: [id], onDelete: Cascade)
  awayId Int

  @@unique([division, group, homeId, awayId])
}

// Сохранённая генерация графики: id шаблона + payload формы (JSON строкой, sqlite).
// Нужна, чтобы переоткрыть прошлый анонс и поправить, а не собирать заново.
model Render {
  id         Int      @id @default(autoincrement())
  templateId String
  title      String?
  payload    String // JSON
  createdAt  DateTime @default(now())

  match   Match? @relation(fields: [matchId], references: [id])
  matchId Int?
}

/// Сессия шоу-драфта UNDERBEER 2.0. Оператор на эфире собирает команды из живого ростера:
/// капитаны по очереди берут игроков, у каждой команды по разу есть «закрепить» и «украсть».
/// Это НЕ ростер лиги (RosterSpot) — эфемерный вывод оператора, как Render: всё состояние
/// лежит в payload JSON-строкой (sqlite), связей по FK с Player нет намеренно. В payload — только
/// id игроков; их карточки (ник/фото/mmr) резолвятся из ростера при чтении (src/lib/draft-data.ts),
/// ушедший из ростера игрок из состава просто выпадает — драфт живёт один эфир, это допустимо.
model DraftSession {
  id        Int      @id @default(autoincrement())
  title     String?
  status    String   @default("draft") // draft | done
  payload   String // JSON всего состояния драфта (src/lib/draft.ts → DraftState)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Кэш статы из OpenDota (по игроку в матче) — для инфографики и подсказки MVP.
model MatchStat {
  id           Int    @id @default(autoincrement())
  match        Match  @relation(fields: [matchId], references: [id])
  matchId      Int
  player       Player @relation(fields: [playerId], references: [id])
  playerId     Int
  heroDamage   Int    @default(0)
  netWorth     Int    @default(0)
  kills        Int    @default(0)
  deaths       Int    @default(0)
  assists      Int    @default(0)
  campsStacked Int    @default(0)
  lastHits     Int    @default(0)

  @@unique([matchId, playerId])
}

// Реестр баллов — единственный способ менять очки. Корректировки = новые записи (аудит).
model PointsEntry {
  id          Int      @id @default(autoincrement())
  subjectType String // team | player | caster | streamer
  subjectId   Int // Team.id / Player.id / (позже) staff id
  reason      String // placement | mvp | cast | stream | manual
  amount      Int
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  match   Match? @relation(fields: [matchId], references: [id])
  matchId Int?
}
